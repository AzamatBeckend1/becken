​<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MODA — Магазин одежды</title>
<style>
:root{
  --bg:#0e0e10; --bg2:#16161a; --card:#1c1c21; --card2:#232329;
  --text:#f4f4f5; --muted:#9a9aa3; --accent:#e8c15a; --accent2:#c9972e;
  --line:#2c2c33; --radius:16px; --shadow:0 20px 50px rgba(0,0,0,.45);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',Inter,-apple-system,Roboto,sans-serif;line-height:1.5;overflow-x:hidden}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,select,textarea{font-family:inherit}
img,svg{display:block}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}

/* ===== HEADER ===== */
header{position:sticky;top:0;z-index:50;background:rgba(14,14,16,.85);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.topbar{display:flex;align-items:center;gap:16px;height:64px}
.logo{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:800;letter-spacing:3px;color:var(--text)}
.logo b{color:var(--accent)}
.logo svg{width:26px;height:26px}
nav{display:flex;gap:4px;margin-left:24px}
nav a{color:var(--muted);text-decoration:none;font-size:14px;padding:8px 12px;border-radius:8px;transition:.2s}
nav a:hover,nav a.active{color:var(--text);background:var(--card)}
.search{margin-left:auto;position:relative}
.search input{background:var(--card);border:1px solid var(--line);color:var(--text);border-radius:10px;padding:9px 14px 9px 38px;width:220px;font-size:14px;outline:none;transition:.2s}
.search input:focus{border-color:var(--accent);width:280px}
.search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;stroke:var(--muted)}
.icon-btn{position:relative;width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--card);border:1px solid var(--line);transition:.2s}
.icon-btn:hover{border-color:var(--accent)}
.icon-btn svg{width:19px;height:19px;stroke:var(--text);fill:none;stroke-width:1.8}
.badge{position:absolute;top:-6px;right:-6px;min-width:19px;height:19px;border-radius:10px;background:var(--accent);color:#111;font-size:11px;font-weight:700;display:grid;place-items:center;padding:0 5px;transform:scale(0);transition:.25s}
.badge.show{transform:scale(1)}

/* ===== HERO ===== */
.hero{position:relative;overflow:hidden;background:linear-gradient(120deg,#16161a 0%,#201a10 55%,#16161a 100%);border-bottom:1px solid var(--line)}
.hero .wrap{display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:40px;padding:70px 20px}
.hero h1{font-size:clamp(34px,5vw,58px);line-height:1.1;font-weight:800}
.hero h1 span{color:var(--accent)}
.hero p{color:var(--muted);margin:18px 0 28px;max-width:480px;font-size:16px}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#141414;font-weight:700;padding:13px 28px;border-radius:12px;font-size:15px;transition:.2s}
.btn:hover{background:var(--accent2);transform:translateY(-2px)}
.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--text)}
.btn.ghost:hover{border-color:var(--accent);color:var(--accent)}
.btn.sm{padding:9px 16px;font-size:13px;border-radius:10px}
.hero-art{position:relative;height:340px}
.float-card{position:absolute;background:var(--card2);border:1px solid var(--line);border-radius:var(--radius);padding:18px;width:180px;box-shadow:var(--shadow);animation:float 6s ease-in-out infinite}
.float-card .pc{height:130px;border-radius:12px;display:grid;place-items:center;margin-bottom:12px}
.float-card .pc svg{width:60%;height:60%}
.float-card h4{font-size:14px}
.float-card .pr{color:var(--accent);font-weight:700;font-size:15px}
@keyframes float{0%,100%{transform:translateY(0) rotate(var(--r,0deg))}50%{transform:translateY(-14px) rotate(var(--r,0deg))}}
.fc1{top:0;left:10px;--r:-4deg}
.fc2{top:70px;right:0;--r:5deg;animation-delay:-2s}
.fc3{bottom:0;left:35%;--r:-2deg;animation-delay:-4s}

/* ===== TOOLBAR ===== */
.toolbar{display:flex;align-items:center;gap:14px;margin:36px 0 22px;flex-wrap:wrap}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:9px 18px;border-radius:999px;background:var(--card);border:1px solid var(--line);color:var(--muted);font-size:14px;transition:.2s}
.chip:hover{color:var(--text)}
.chip.active{background:var(--accent);border-color:var(--accent);color:#141414;font-weight:700}
.sort{margin-left:auto;background:var(--card);border:1px solid var(--line);color:var(--text);padding:9px 14px;border-radius:10px;font-size:14px;outline:none}
.count{color:var(--muted);font-size:13px;width:100%;order:9}

/* ===== GRID / CARDS ===== */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:22px;padding-bottom:60px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:.25s;cursor:pointer;position:relative}
.card:hover{transform:translateY(-6px);border-color:#3d3d47;box-shadow:var(--shadow)}
.pimg{height:230px;display:grid;place-items:center;position:relative;overflow:hidden}
.pimg svg{width:52%;height:52%;transition:.4s}
.card:hover .pimg svg{transform:scale(1.12) rotate(-3deg)}
.tag{position:absolute;top:12px;left:12px;background:rgba(14,14,16,.75);backdrop-filter:blur(6px);color:var(--accent);font-size:11px;font-weight:700;padding:5px 10px;border-radius:8px;text-transform:uppercase;letter-spacing:1px}
.fav{position:absolute;top:10px;right:10px;width:36px;height:36px;border-radius:50%;background:rgba(14,14,16,.7);backdrop-filter:blur(6px);display:grid;place-items:center;transition:.2s;opacity:0}
.card:hover .fav{opacity:1}
.fav svg{width:17px;height:17px;stroke:var(--text);fill:none;stroke-width:2;transition:.2s}
.fav.on svg{fill:var(--accent);stroke:var(--accent)}
.pbody{padding:16px}
.pbody .cat{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:1px}
.pbody h3{font-size:15px;margin:4px 0 6px;font-weight:600}
.stars{display:flex;align-items:center;gap:6px;margin-bottom:10px}
.stars svg{width:14px;height:14px;fill:var(--accent)}
.stars span{color:var(--muted);font-size:12px}
.prow{display:flex;align-items:center;justify-content:space-between}
.price{font-size:17px;font-weight:800}
.price s{color:var(--muted);font-weight:400;font-size:13px;margin-left:8px}
.add{width:38px;height:38px;border-radius:11px;background:var(--card2);border:1px solid var(--line);display:grid;place-items:center;transition:.2s}
.add svg{width:17px;height:17px;stroke:var(--text);stroke-width:2;fill:none}
.add:hover{background:var(--accent);border-color:var(--accent)}
.add:hover svg{stroke:#141414}
.empty-msg{grid-column:1/-1;text-align:center;color:var(--muted);padding:60px 0;font-size:16px}

/* ===== DRAWER (cart) ===== */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:.3s;z-index:90}
.overlay.open{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:-420px;width:400px;max-width:92vw;height:100vh;background:var(--bg2);border-left:1px solid var(--line);z-index:100;display:flex;flex-direction:column;transition:right .35s cubic-bezier(.6,0,.2,1)}
.drawer.open{right:0}
.dhead{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid var(--line)}
.dhead h2{font-size:19px}
.dhead button{width:36px;height:36px;border-radius:10px;background:var(--card);font-size:18px;color:var(--muted)}
.dhead button:hover{color:var(--text)}
.ditems{flex:1;overflow-y:auto;padding:16px 24px;display:flex;flex-direction:column;gap:14px}
.ditem{display:flex;gap:14px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px}
.ditem .th{width:64px;height:64px;border-radius:10px;display:grid;place-items:center;flex-shrink:0}
.ditem .th svg{width:60%;height:60%}
.ditem h4{font-size:13.5px;font-weight:600}
.ditem .dmeta{color:var(--muted);font-size:12px;margin:2px 0 8px}
.qty{display:flex;align-items:center;gap:10px}
.qty button{width:24px;height:24px;border-radius:7px;background:var(--card2);border:1px solid var(--line);font-size:14px;line-height:1}
.qty button:hover{border-color:var(--accent)}
.ditem .dp{margin-left:auto;font-weight:700;font-size:14px;white-space:nowrap}
.del{color:var(--muted);font-size:16px;margin-left:6px}
.del:hover{color:#e05c5c}
.dempty{text-align:center;color:var(--muted);padding:60px 10px}
.dempty svg{width:56px;height:56px;stroke:var(--muted);margin:0 auto 14px;fill:none;stroke-width:1.4}
.dfoot{padding:18px 24px;border-top:1px solid var(--line)}
.promo{display:flex;gap:8px;margin-bottom:14px}
.promo input{flex:1;background:var(--card);border:1px solid var(--line);color:var(--text);border-radius:10px;padding:10px 12px;font-size:13px;outline:none;text-transform:uppercase}
.promo input:focus{border-color:var(--accent)}
.trow{display:flex;justify-content:space-between;font-size:14px;color:var(--muted);margin-bottom:6px}
.trow.total{font-size:18px;color:var(--text);font-weight:800;margin:10px 0 16px}
.trow .free{color:#7ad88f;font-weight:700}
.w100{width:100%;justify-content:center}

/* ===== MODAL ===== */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(4px);z-index:120;display:grid;place-items:center;opacity:0;pointer-events:none;transition:.3s;padding:20px}
.modal-bg.open{opacity:1;pointer-events:auto}
.modal{background:var(--bg2);border:1px solid var(--line);border-radius:20px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;transform:scale(.92) translateY(14px);transition:.3s}
.modal-bg.open .modal{transform:none}
.mhead{display:flex;justify-content:space-between;align-items:center;padding:20px 26px;border-bottom:1px solid var(--line)}
.mhead h2{font-size:19px}
.mhead button{width:34px;height:34px;border-radius:10px;background:var(--card);color:var(--muted);font-size:17px}
.mbody{padding:22px 26px}
.qv{display:grid;grid-template-columns:180px 1fr;gap:22px}
.qv .qi{height:200px;border-radius:14px;display:grid;place-items:center}
.qv .qi svg{width:55%;height:55%}
.qv h3{font-size:19px;margin-bottom:6px}
.qv .qp{font-size:22px;font-weight:800;color:var(--accent);margin:10px 0}
.sizes{display:flex;gap:8px;margin:12px 0}
.size{width:40px;height:40px;border-radius:10px;border:1px solid var(--line);background:var(--card);font-size:13px;transition:.15s}
.size.sel{background:var(--accent);color:#141414;border-color:var(--accent);font-weight:700}
.field{margin-bottom:14px}
.field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:6px}
.field input,.field textarea{width:100%;background:var(--card);border:1px solid var(--line);color:var(--text);border-radius:10px;padding:11px 13px;font-size:14px;outline:none}
.field input:focus,.field textarea:focus{border-color:var(--accent)}
.field.err input{border-color:#e05c5c}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.dlvr{display:flex;gap:10px;margin-bottom:16px}
.dopt{flex:1;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px;cursor:pointer;text-align:center;transition:.2s}
.dopt.sel{border-color:var(--accent);background:#241f12}
.dopt b{display:block;font-size:14px}
.dopt span{font-size:12px;color:var(--muted)}
.success{text-align:center;padding:34px 20px}
.success .ok{width:74px;height:74px;border-radius:50%;background:rgba(122,216,143,.12);border:2px solid #7ad88f;display:grid;place-items:center;margin:0 auto 18px}
.success .ok svg{width:36px;height:36px;stroke:#7ad88f;stroke-width:2.4;fill:none}
.success h2{margin-bottom:8px}
.success p{color:var(--muted);font-size:14px}

/* ===== FOOTER ===== */
footer{border-top:1px solid var(--line);background:var(--bg2)}
.fgrid{display:grid;grid-template-columns:2fr 1fr 1fr 1.4fr;gap:36px;padding:50px 20px}
footer h4{font-size:14px;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:16px;color:var(--accent)}
footer a{display:block;color:var(--muted);text-decoration:none;font-size:14px;margin-bottom:10px;transition:.2s}
footer a:hover{color:var(--text)}
footer p{color:var(--muted);font-size:13.5px;max-width:280px}
.fbottom{border-top:1px solid var(--line);padding:18px 0;text-align:center;color:var(--muted);font-size:13px}

/* ===== TOAST ===== */
.toasts{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:200;display:flex;flex-direction:column;gap:10px;align-items:center}
.toast{background:var(--card2);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:12px;padding:12px 20px;font-size:14px;box-shadow:var(--shadow);animation:toastIn .3s}
@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}

@media(max-width:900px){
  .hero .wrap{grid-template-columns:1fr;padding:50px 20px}
  .hero-art{display:none}
  nav{display:none}
  .fgrid{grid-template-columns:1fr 1fr}
  .qv{grid-template-columns:1fr}
  .search input{width:150px}
}
</style>
</head>
<body>

<header>
  <div class="wrap topbar">
    <a href="#" class="logo" style="text-decoration:none;color:inherit">
      <svg viewBox="0 0 24 24" fill="none" stroke="#e8c15a" stroke-width="2"><path d="M6 3h12l2 5-3 2v11H7V10L4 8l2-5z"/></svg>
      MO<b>DA</b>
    </a>
    <nav>
      <a href="#catalog" class="active">Каталог</a>
      <a href="#catalog">Мужское</a>
      <a href="#catalog">Женское</a>
      <a href="#catalog">Обувь</a>
      <a href="#catalog">Аксессуары</a>
    </nav>
    <div class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input id="search" placeholder="Поиск товаров...">
    </div>
    <button class="icon-btn" id="favBtn" title="Избранное">
      <svg viewBox="0 0 24 24"><path d="M12 21C7 16.5 3 13 3 8.8 3 6 5.2 4 7.8 4c1.7 0 3.2.9 4.2 2.3C13 4.9 14.5 4 16.2 4 18.8 4 21 6 21 8.8c0 4.2-4 7.7-9 12.2z"/></svg>
      <span class="badge" id="favBadge">0</span>
    </button>
    <button class="icon-btn" id="cartBtn" title="Корзина">
      <svg viewBox="0 0 24 24"><path d="M6 7h12l1.5 13h-15L6 7z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
      <span class="badge" id="cartBadge">0</span>
    </button>
  </div>
</header>

<section class="hero">
  <div class="wrap">
    <div>
      <h1>Осенняя коллекция <span>2026</span><br>уже в продаже</h1>
      <p>Премиальная одежда для тех, кто ценит стиль и качество. Бесплатная доставка от 5 000 ₽, возврат до 30 дней.</p>
      <a href="#catalog" class="btn">Смотреть каталог
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <button class="btn ghost" style="margin-left:12px" onclick="toast('Промокод MODA10 — скидка 10% на всё!')">Получить скидку −10%</button>
    </div>
    <div class="hero-art" id="heroArt"></div>
  </div>
</section>

<main class="wrap" id="catalog">
  <div class="toolbar">
    <div class="chips" id="chips"></div>
    <select class="sort" id="sort">
      <option value="pop">Сначала популярные</option>
      <option value="asc">Цена: по возрастанию</option>
      <option value="desc">Цена: по убыванию</option>
      <option value="rate">По рейтингу</option>
    </select>
    <span class="count" id="count"></span>
  </div>
  <div class="grid" id="grid"></div>
</main>

<footer>
  <div class="wrap fgrid">
    <div>
      <h4>MODA</h4>
      <p>Современный магазин одежды. Только качественные материалы, честные цены и стиль, который говорит за вас.</p>
    </div>
    <div>
      <h4>Покупателям</h4>
      <a href="#">Доставка и оплата</a><a href="#">Возврат и обмен</a><a href="#">Размерная сетка</a><a href="#">Вопросы и ответы</a>
    </div>
    <div>
      <h4>Компания</h4>
      <a href="#">О нас</a><a href="#">Магазины</a><a href="#">Вакансии</a><a href="#">Контакты</a>
    </div>
    <div>
      <h4>Подписка</h4>
      <p style="margin-bottom:12px">Новинки и скидки — на почту.</p>
      <div class="promo"><input id="subEmail" placeholder="Ваш e-mail"><button class="btn sm" onclick="subscribe()">ОК</button></div>
    </div>
  </div>
  <div class="fbottom">© 2026 MODA. Все права защищены.</div>
</footer>

<div class="overlay" id="overlay"></div>

<aside class="drawer" id="drawer">
  <div class="dhead"><h2>Корзина</h2><button onclick="closeDrawer()">✕</button></div>
  <div class="ditems" id="ditems"></div>
  <div class="dfoot" id="dfoot"></div>
</aside>

<div class="modal-bg" id="modalBg">
  <div class="modal" id="modal"></div>
</div>

<div class="toasts" id="toasts"></div>

<script>
/* ================= DATA ================= */
const G = (paths, color) => `<svg viewBox="0 0 64 64" fill="none" stroke="${color}" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round">${paths}</svg>`;
const ICONS = {
