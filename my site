  shoe:   G('<path d="M8 44c0-4 2-8 4-8 6 0 10-8 14-8 8 0 10 10 18 12 8 2 12 4 12 6v4H8z"/><path d="M18 30l4-4M26 26l4-4"/>','#f4f4f5'),
  bag:    G('<path d="M14 24h36l-3 30H17z"/><path d="M24 24v-6a8 8 0 0 1 16 0v6"/>','#f4f4f5'),
  cap:    G('<path d="M14 38c0-12 8-20 18-20s18 8 18 20"/><path d="M10 38h44l-2 6H12z"/><path d="M32 18v20"/>','#f4f4f5'),
  watch:  G('<circle cx="32" cy="34" r="14"/><path d="M32 27v7l5 4"/><path d="M26 8h12v12H26zM26 48h12v8H26z"/>','#f4f4f5'),
};
const CATS = ['Все','Мужское','Женское','Обувь','Аксессуары'];
const GRADS = {
  tee:'linear-gradient(140deg,#3b4a6b,#232a3d)', hoodie:'linear-gradient(140deg,#6b3b52,#3d232c)',
  jacket:'linear-gradient(140deg,#3b6b52,#233d32)', jeans:'linear-gradient(140deg,#4a4a6b,#2a2a3d)',
  dress:'linear-gradient(140deg,#7a4a2b,#453021)', coat:'linear-gradient(140deg,#5a5a44,#33332a)',
  shoe:'linear-gradient(140deg,#44556b,#28303d)', bag:'linear-gradient(140deg,#6b5a2b,#3d3421)',
  cap:'linear-gradient(140deg,#59406b,#342540)', watch:'linear-gradient(140deg,#2b5a6b,#193540)',
};
const PRODUCTS = [
  {id:1, name:'Футболка Essential', cat:'Мужское', type:'tee', price:1990, old:2490, rating:4.8, rev:214, tag:'Хит'},
  {id:2, name:'Худи Oversize Cloud', cat:'Мужское', type:'hoodie', price:3990, old:4990, rating:4.9, rev:187, tag:'Sale'},
  {id:3, name:'Бомбер Urban', cat:'Мужское', type:'jacket', price:7990, old:null, rating:4.7, rev:96},
  {id:4, name:'Джинсы Slim Fit', cat:'Мужское', type:'jeans', price:3490, old:4290, rating:4.6, rev:154},
  {id:5, name:'Пальто Milano', cat:'Женское', type:'coat', price:12990, old:15990, rating:4.9, rev:78, tag:'New'},
  {id:6, name:'Платье Aurora', cat:'Женское', type:'dress', price:5490, old:null, rating:4.8, rev:133},
  {id:7, name:'Куртка Denim', cat:'Женское', type:'jacket', price:6490, old:7990, rating:4.5, rev:87, tag:'Sale'},
  {id:8, name:'Худи Cozy', cat:'Женское', type:'hoodie', price:3590, old:null, rating:4.7, rev:201},
  {id:9, name:'Кроссовки Runner X', cat:'Обувь', type:'shoe', price:8990, old:10990, rating:4.9, rev:342, tag:'Хит'},
  {id:10, name:'Кеды Classic', cat:'Обувь', type:'shoe', price:4590, old:null, rating:4.6, rev:156},
  {id:11, name:'Сумка Leather', cat:'Аксессуары', type:'bag', price:6990, old:8490, rating:4.8, rev:64, tag:'Sale'},
  {id:12, name:'Кепка Street', cat:'Аксессуары', type:'cap', price:1490, old:null, rating:4.4, rev:92},
  {id:13, name:'Часы Minimal', cat:'Аксессуары', type:'watch', price:15990, old:null, rating:5.0, rev:41, tag:'New'},
  {id:14, name:'Футболка Premium', cat:'Женское', type:'tee', price:2290, old:2890, rating:4.7, rev:118},
];
const SIZES = ['XS','S','M','L','XL'];

/* ================= STATE ================= */
let cart = {};      // id -> {qty, size}
let favs = new Set();
let activeCat = 'Все', query = '', sortBy = 'pop', promo = 0;
const fmt = n => n.toLocaleString('ru-RU') + ' ₽';

/* ================= HELPERS ================= */
const $ = s => document.querySelector(s);
function stars(r){
  let s='';
  for(let i=1;i<=5;i++) s += `<svg viewBox="0 0 24 24" style="opacity:${i<=Math.round(r)?1:.22}"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 16.9 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg>`;
  return s;
}
function toast(msg){
  const t = document.createElement('div');
  t.className='toast'; t.textContent=msg;
  $('#toasts').appendChild(t);
  setTimeout(()=>{t.style.opacity='0';t.style.transition='.4s';setTimeout(()=>t.remove(),400)},2600);
}
function icon(type){ return ICONS[type]; }

/* ================= RENDER: CHIPS + GRID ================= */
function renderChips(){
  $('#chips').innerHTML = CATS.map(c=>`<button class="chip ${c===activeCat?'active':''}" onclick="setCat('${c}')">${c}</button>`).join('');
}
function setCat(c){ activeCat=c; renderChips(); renderGrid(); }

function getFiltered(){
  let list = PRODUCTS.filter(p =>
    (activeCat==='Все' || p.cat===activeCat) &&
    p.name.toLowerCase().includes(query.toLowerCase())
  );
  if(sortBy==='asc') list.sort((a,b)=>a.price-b.price);
  else if(sortBy==='desc') list.sort((a,b)=>b.price-a.price);
  else if(sortBy==='rate') list.sort((a,b)=>b.rating-a.rating);
  else list.sort((a,b)=>b.rev-a.rev);
  return list;
}

function renderGrid(){
  const list = getFiltered();
  $('#count').textContent = `Найдено: ${list.length} товаров`;
  if(!list.length){ $('#grid').innerHTML = '<div class="empty-msg">Ничего не найдено. Попробуйте изменить запрос.</div>'; return; }
  $('#grid').innerHTML = list.map(p=>`
    <div class="card" onclick="openQuick(${p.id})">
      <div class="pimg" style="background:${GRADS[p.type]}">
        ${p.tag?`<span class="tag">${p.tag}</span>`:''}
        <button class="fav ${favs.has(p.id)?'on':''}" onclick="event.stopPropagation();toggleFav(${p.id},this)" title="В избранное">
          <svg viewBox="0 0 24 24"><path d="M12 21C7 16.5 3 13 3 8.8 3 6 5.2 4 7.8 4c1.7 0 3.2.9 4.2 2.3C13 4.9 14.5 4 16.2 4 18.8 4 21 6 21 8.8c0 4.2-4 7.7-9 12.2z"/></svg>
        </button>
        ${icon(p.type)}
      </div>
      <div class="pbody">
        <span class="cat">${p.cat}</span>
        <h3>${p.name}</h3>
        <div class="stars">${stars(p.rating)}<span>${p.rating} (${p.rev})</span></div>
        <div class="prow">
          <span class="price">${fmt(p.price)}${p.old?`<s>${fmt(p.old)}</s>`:''}</span>
          <button class="add" onclick="event.stopPropagation();addToCart(${p.id})" title="В корзину">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          </button>
        </div>
      </div>
    </div>`).join('');
}

/* ================= HERO ART ================= */
(function(){
  const picks = [PRODUCTS[1], PRODUCTS[8], PRODUCTS[5]];
  $('#heroArt').innerHTML = picks.map((p,i)=>`
    <div class="float-card fc${i+1}">
      <div class="pc" style="background:${GRADS[p.type]}">${icon(p.type)}</div>
      <h4>${p.name}</h4><span class="pr">${fmt(p.price)}</span>
    </div>`).join('');
})();

/* ================= CART ================= */
function toggleFav(id, el){
  if(favs.has(id)){ favs.delete(id); toast('Удалено из избранного'); }
  else { favs.add(id); toast('Добавлено в избранное'); }
  if(el) el.classList.toggle('on');
  updateBadges();
}
function addToCart(id, size='M'){
  const key = id+':'+size;
  cart[key] = cart[key] || {id, size, qty:0};
  cart[key].qty++;
  updateBadges(); renderDrawer();
  toast('Добавлено в корзину: ' + PRODUCTS.find(p=>p.id===id).name);
}
function cartCount(){ return Object.values(cart).reduce((s,i)=>s+i.qty,0); }
function cartTotal(){
  let t = Object.values(cart).reduce((s,i)=> s + PRODUCTS.find(p=>p.id===i.id).price * i.qty, 0);
  return {sub:t, disc:t*promo, total:t*(1-promo)};
}
function updateBadges(){
  const c = cartCount();
  $('#cartBadge').textContent = c; $('#cartBadge').classList.toggle('show', c>0);
  $('#favBadge').textContent = favs.size; $('#favBadge').classList.toggle('show', favs.size>0);
}
function changeQty(key, d){
  cart[key].qty += d;
  if(cart[key].qty<=0) delete cart[key];
  updateBadges(); renderDrawer();
}
function removeItem(key){ delete cart[key]; updateBadges(); renderDrawer(); }

function renderDrawer(){
  const items = Object.entries(cart);
  const box = $('#ditems'), foot = $('#dfoot');
  if(!items.length){
    box.innerHTML = `<div class="dempty">
      <svg viewBox="0 0 24 24"><path d="M6 7h12l1.5 13h-15L6 7z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
      Корзина пуста.<br>Добавьте что-нибудь из каталога.</div>`;
    foot.innerHTML=''; return;
  }
  box.innerHTML = items.map(([key,i])=>{
    const p = PRODUCTS.find(x=>x.id===i.id);
    return `<div class="ditem">
      <div class="th" style="background:${GRADS[p.type]}">${icon(p.type)}</div>
      <div>
        <h4>${p.name}</h4>
        <div class="dmeta">Размер: ${i.size} · ${fmt(p.price)}</div>
        <div class="qty">
          <button onclick="changeQty('${key}',-1)">−</button><b>${i.qty}</b><button onclick="changeQty('${key}',1)">+</button>
          <button class="del" onclick="removeItem('${key}')" title="Удалить">🗑</button>
        </div>
      </div>
      <span class="dp">${fmt(p.price*i.qty)}</span>
    </div>`;
  }).join('');
  const t = cartTotal();
  foot.innerHTML = `
    <div class="promo">
      <input id="promo" placeholder="Промокод (MODA10)" value="${promo?'MODA10':''}">
      <button class="btn sm" onclick="applyPromo()">Применить</button>
    </div>
    <div class="trow"><span>Товары (${cartCount()})</span><span>${fmt(t.sub)}</span></div>
    ${promo?`<div class="trow" style="color:#7ad88f"><span>Скидка 10%</span><span>−${fmt(t.disc)}</span></div>`:''}
    <div class="trow"><span>Доставка</span>${t.total>=5000?'<span class="free">Бесплатно</span>':`<span>${fmt(490)}</span>`}</div>
    <div class="trow total"><span>Итого</span><span>${fmt(t.total + (t.total>=5000?0:490))}</span></div>
    <button class="btn w100" onclick="openCheckout()">Оформить заказ</button>`;
}
function applyPromo(){
  const v = $('#promo').value.trim().toUpperCase();
  if(v==='MODA10'){ promo=0.10; toast('Промокод применён: −10%'); }
  else { promo=0; toast('Промокод не найден'); }
  renderDrawer();
}
function openDrawer(){ $('#drawer').classList.add('open'); $('#overlay').classList.add('open'); renderDrawer(); }
function closeDrawer(){ $('#drawer').classList.remove('open'); $('#overlay').classList.remove('open'); }
$('#cartBtn').onclick = openDrawer;
$('#overlay').onclick = closeDrawer;

/* ================= QUICK VIEW ================= */
let qvSize = 'M';
function openQuick(id){
  const p = PRODUCTS.find(x=>x.id===id); qvSize='M';
  $('#modal').innerHTML = `
    <div class="mhead"><h2>Быстрый просмотр</h2><button onclick="closeModal()">✕</button></div>
    <div class="mbody">
      <div class="qv">
        <div class="qi" style="background:${GRADS[p.type]}">${icon(p.type)}</div>
        <div>
          <span class="cat" style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:1px">${p.cat}</span>
          <h3>${p.name}</h3>
          <div class="stars">${stars(p.rating)}<span>${p.rating} · ${p.rev} отзывов</span></div>
          <div class="qp">${fmt(p.price)}${p.old?`<s style="color:var(--muted);font-size:15px;font-weight:400;margin-left:8px">${fmt(p.old)}</s>`:''}</div>
          <div style="font-size:12.5px;color:var(--muted);margin-bottom:4px">Размер:</div>
          <div class="sizes" id="qvSizes">${SIZES.map(s=>`<button class="size ${s==='M'?'sel':''}" onclick="pickSize('${s}',this)">${s}</button>`).join('')}</div>
          <button class="btn w100" onclick="addToCart(${p.id},qvSize);closeModal();openDrawer()">В корзину — ${fmt(p.price)}</button>
        </div>
      </div>
    </div>`;
  openModal();
}
function pickSize(s, el){ qvSize=s; document.querySelectorAll('#qvSizes .size').forEach(b=>b.classList.remove('sel')); el.classList.add('sel'); }

/* ================= CHECKOUT ================= */
let delivery = 'courier';
function openCheckout(){
  if(!cartCount()) return;
  const t = cartTotal();
  const ship = t.total>=5000?0:490;
  $('#modal').innerHTML = `
    <div class="mhead"><h2>Оформление заказа</h2><button onclick="closeModal()">✕</button></div>
    <div class="mbody">
      <div class="dlvr">
        <div class="dopt sel" id="d-courier" onclick="setDelivery('courier')"><b>Курьер</b><span>1–3 дня · ${t.total>=5000?'бесплатно':'490 ₽'}</span></div>
        <div class="dopt" id="d-point" onclick="setDelivery('point')"><b>Пункт выдачи</b><span>2–4 дня · 290 ₽</span></div>
      </div>
      <div class="field" id="f-name"><label>Имя и фамилия</label><input id="o-name" placeholder="Иван Петров"></div>
      <div class="frow">
        <div class="field" id="f-phone"><label>Телефон</label><input id="o-phone" placeholder="+7 999 000-00-00"></div>
        <div class="field" id="f-email"><label>E-mail</label><input id="o-email" placeholder="mail@example.com"></div>
      </div>
      <div class="field" id="f-addr"><label>Адрес доставки</label><input id="o-addr" placeholder="Город, улица, дом, квартира"></div>
      <div class="trow"><span>Товары</span><span>${fmt(t.sub)}</span></div>
      ${promo?`<div class="trow" style="color:#7ad88f"><span>Скидка</span><span>−${fmt(t.disc)}</span></div>`:''}
      <div class="trow" id="shipRow"><span>Доставка</span><span>${ship?fmt(ship):'Бесплатно'}</span></div>
      <div class="trow total"><span>К оплате</span><span id="payTotal">${fmt(t.total+ship)}</span></div>
      <button class="btn w100" onclick="submitOrder()">Подтвердить заказ</button>
    </div>`;
  openModal();
}
function setDelivery(d){
  delivery=d;
  $('#d-courier').classList.toggle('sel', d==='courier');
  $('#d-point').classList.toggle('sel', d==='point');
  const t = cartTotal();
  const ship = d==='point'?290:(t.total>=5000?0:490);
  $('#shipRow').innerHTML = `<span>Доставка</span><span>${ship?fmt(ship):'Бесплатно'}</span>`;
  $('#payTotal').textContent = fmt(t.total+ship);
  $('#f-addr').style.display = d==='courier'?'':'none';
}
function submitOrder(){
  let ok = true;
  const check = (id, cond) => { $(id).parentElement.classList.toggle('err', !cond); if(!cond) ok=false; };
  check('#o-name', $('#o-name').value.trim().length>2);
  check('#o-phone', $('#o-phone').value.replace(/\D/g,'').length>=10);
  check('#o-email', /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test($('#o-email').value));
  if(delivery==='courier') check('#o-addr', $('#o-addr').value.trim().length>5);
  if(!ok){ toast('Проверьте выделенные поля'); return; }
  const num = 'MD-' + Math.floor(100000 + Math.random()*900000);
  cart = {}; promo = 0; updateBadges();
  $('#modal').innerHTML = `
    <div class="success">
      <div class="ok"><svg viewBox="0 0 24 24"><path d="M4 12.5 10 18.5 20 6.5"/></svg></div>
      <h2>Заказ оформлен!</h2>
      <p>Номер заказа: <b style="color:var(--accent)">${num}</b><br>Мы свяжемся с вами для подтверждения.<br>Спасибо за покупку в MODA!</p>
      <button class="btn" style="margin-top:22px" onclick="closeModal()">Продолжить покупки</button>
    </div>`;
}

/* ================= MODAL ================= */
function openModal(){ $('#modalBg').classList.add('open'); }
function closeModal(){ $('#modalBg').classList.remove('open'); }
$('#modalBg').addEventListener('click', e=>{ if(e.target.id==='modalBg') closeModal(); });
document.addEventListener('keydown', e=>{ if(e.key==='Escape'){ closeModal(); closeDrawer(); } });

/* ================= EVENTS ================= */
$('#search').addEventListener('input', e=>{ query=e.target.value; renderGrid(); });
$('#sort').addEventListener('change', e=>{ sortBy=e.target.value; renderGrid(); });
$('#favBtn').onclick = ()=>{
  if(!favs.size) return toast('В избранном пока пусто');
  const names = [...favs].map(id=>PRODUCTS.find(p=>p.id===id).name).join(', ');
  toast('Избранное: ' + names);
};
function subscribe(){
  const v = $('#subEmail').value;
  if(/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)){ toast('Вы подписаны на рассылку!'); $('#subEmail').value=''; }
  else toast('Введите корректный e-mail');
}

/* INIT */
renderChips(); renderGrid(); updateBadges();
</script>
</body>
</html>
